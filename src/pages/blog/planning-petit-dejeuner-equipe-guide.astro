            <td><span class="tag-ok">2 minutes</span></td>
          </tr>
          <tr>
            <td>Gestion des absences</td>
            <td><span class="tag-warn">Manuelle</span></td>
            <td><span class="tag-ok">Automatique</span></td>
          </tr>
          <tr>
            <td>Équité garantie</td>
            <td><span class="tag-warn">Approximative</span></td>
            <td><span class="tag-ok">Calculée</span></td>
          </tr>
          <tr>
            <td>Charge de maintenance</td>
            <td><span class="tag-warn">Hebdomadaire</span></td>
            <td><span class="tag-ok">Zéro</span></td>
          </tr>
          <tr>
            <td>Idéal pour</td>
            <td>3-4 personnes</td>
