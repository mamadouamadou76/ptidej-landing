---
const title = "Blog — P'tit Déj";
const description = "Conseils et idées sur les rituels d'équipe, la cohésion et l'organisation au bureau.";
const canonical = "https://ptidej.fr/blog";

const articles = [
  {
    slug: "planning-petit-dejeuner-equipe-guide",
    title: "Comment organiser un planning de petit-déjeuner d'équipe équitable (guide complet)",
    excerpt: "Entre les oublis, les inégalités perçues et la gestion des absences, organiser un planning qui dure vraiment demande une méthode. Comparatif tableur vs rotation automatique, étapes et erreurs à éviter.",
    date: "15 juin 2026",
    dateISO: "2026-06-15",
    readingTime: "8 min",
    cover: "https://images.unsplash.com/photo-1521017432531-fbd92d768814?w=800&auto=format&fit=crop&q=80",
    coverAlt: "Carnet de notes et tasse de café sur un bureau, planification d'un rituel d'équipe",
  },
  {
    slug: "petites-attentions-bureau",
    title: "Pourquoi les petites attentions au bureau comptent (et comment les automatiser)",
    excerpt: "Les petits rituels partagés renforcent la cohésion d'équipe bien plus efficacement que les grands team buildings annuels. Mais sans organisation, ils reposent toujours sur les mêmes personnes.",
    date: "15 juin 2026",
    dateISO: "2026-06-15",
    readingTime: "7 min",
    cover: "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=800&auto=format&fit=crop&q=80",
    coverAlt: "Tasse de café fumante sur une table en bois clair au soleil du matin",
  }
];
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="P'tit Déj" />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="P'tit Déj" />
  <meta name="theme-color" content="#D97706" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;0,9..40,800;1,9..40,400&display=swap" rel="stylesheet" />

  <!-- Microsoft Clarity -->
  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "x5xj8iwm95");
  </script>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --amber-50:  #FFFBEB;
      --amber-100: #FEF3C7;
      --amber-200: #FDE68A;
      --amber-400: #FBBF24;
      --amber-500: #F59E0B;
      --amber-600: #D97706;
      --amber-700: #B45309;
      --stone-50:  #FAFAF9;
      --stone-100: #F5F5F4;
      --stone-200: #E7E5E4;
      --stone-400: #A8A29E;
      --stone-600: #57534E;
      --stone-700: #44403C;
      --stone-900: #1C1917;
      --white: #FFFFFF;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background-color: var(--stone-50);
      color: var(--stone-900);
      overflow-x: hidden;
      min-height: 100vh;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
    }

    /* NAV */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 2rem;
      background: rgba(250,250,249,0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--stone-200);
    }

    .nav-logo {
      font-family: 'DM Sans', sans-serif;
      font-weight: 800;
      font-size: 1.2rem;
      color: var(--stone-900);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-logo-dot {
      width: 8px; height: 8px;
      background: var(--amber-500);
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .nav-link {
      font-family: 'DM Sans', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--stone-700);
      text-decoration: none;
      transition: color 0.2s;
    }
    .nav-link:hover { color: var(--amber-600); }
    .nav-link.active { color: var(--amber-600); }

    .nav-app-btn {
      font-family: 'DM Sans', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      background: var(--amber-500);
      color: var(--white);
      text-decoration: none;
      padding: 0.6rem 1.2rem;
      border-radius: 12px;
      transition: background 0.2s, transform 0.15s;
      white-space: nowrap;
    }
    .nav-app-btn:hover { background: var(--amber-600); transform: scale(1.02); }

    /* PAGE */
    .page-wrap {
      position: relative;
      z-index: 1;
      max-width: 860px;
      margin: 0 auto;
      padding: 8rem 1.5rem 5rem;
    }

    /* HEADER */
    .blog-header {
      margin-bottom: 3.5rem;
    }

    .page-breadcrumb {
      font-size: 0.8rem;
      color: var(--stone-400);
      margin-bottom: 1.5rem;
    }

    .page-breadcrumb a {
      color: var(--amber-600);
      text-decoration: none;
    }
    .page-breadcrumb a:hover { text-decoration: underline; }

    .blog-title {
      font-weight: 800;
      font-size: clamp(2rem, 4vw, 3rem);
      letter-spacing: -0.025em;
      line-height: 1.15;
      color: var(--stone-900);
      margin-bottom: 0.75rem;
    }

    .blog-subtitle {
      font-size: 1.05rem;
      color: var(--stone-600);
      line-height: 1.6;
    }

    /* ARTICLE LIST */
    .articles-list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .article-card {
      background: var(--white);
      border: 1px solid var(--stone-200);
      border-radius: 16px;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      display: block;
      transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
    }

    .article-card-body {
      padding: 1.75rem 2rem 2rem;
    }

    .article-card-cover {
      width: 100%;
      aspect-ratio: 16 / 7;
      object-fit: cover;
      display: block;
    }

    .article-card:hover {
      border-color: var(--amber-400);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    }

    .article-card-cover {
      transition: transform 0.3s ease;
    }
    .article-card:hover .article-card-cover {
      transform: scale(1.02);
    }

    .article-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.8rem;
      color: var(--stone-400);
      margin-bottom: 0.9rem;
    }

    .article-meta-dot {
      width: 3px;
      height: 3px;
      background: var(--stone-400);
      border-radius: 50%;
    }

    .article-card-title {
      font-weight: 700;
      font-size: 1.2rem;
      line-height: 1.35;
      letter-spacing: -0.01em;
      color: var(--stone-900);
      margin-bottom: 0.6rem;
      transition: color 0.2s;
    }

    .article-card:hover .article-card-title {
      color: var(--amber-600);
    }

    .article-card-excerpt {
      font-size: 0.95rem;
      color: var(--stone-600);
      line-height: 1.65;
      margin-bottom: 1.25rem;
    }

    .article-read-more {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--amber-600);
    }

    /* FOOTER */
    footer {
      background: var(--stone-900);
      color: var(--stone-400);
      padding: 2rem 1.5rem;
      text-align: center;
      font-size: 0.8rem;
      position: relative;
      z-index: 1;
    }

    footer a {
      color: var(--stone-400);
      text-decoration: none;
      margin: 0 0.75rem;
      transition: color 0.2s;
    }
    footer a:hover { color: var(--amber-400); }

    @media (max-width: 600px) {
      nav { padding: 1rem 1.25rem; }
      .nav-app-btn { font-size: 0.78rem; padding: 0.5rem 0.9rem; }
      .page-wrap { padding: 6rem 1.25rem 4rem; }
      .article-card-body { padding: 1.25rem 1.5rem 1.5rem; }
    }
  </style>
</head>

<body>
  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo">
      <span class="nav-logo-dot"></span>
      P'tit Déj
    </a>
    <div class="nav-right">
      <a href="/blog" class="nav-link active">Blog</a>
      <a href="https://app.ptidej.fr" class="nav-app-btn">Accéder à l'app</a>
    </div>
  </nav>

  <!-- CONTENT -->
  <main class="page-wrap">
    <div class="blog-header">
      <p class="page-breadcrumb"><a href="/">Accueil</a> &rsaquo; Blog</p>
      <h1 class="blog-title">Blog</h1>
      <p class="blog-subtitle">Conseils et idées sur les rituels d'équipe, la cohésion et l'organisation au bureau.</p>
    </div>

    <div class="articles-list">
      {articles.map((article) => (
        <a href={`/blog/${article.slug}`} class="article-card">
          {article.cover && (
            <img
              class="article-card-cover"
              src={article.cover}
              alt={article.coverAlt}
              loading="lazy"
              width="800"
              height="350"
            />
          )}
          <div class="article-card-body">
            <div class="article-meta">
              <time datetime={article.dateISO}>{article.date}</time>
              <span class="article-meta-dot"></span>
              <span>{article.readingTime} de lecture</span>
            </div>
            <h2 class="article-card-title">{article.title}</h2>
            <p class="article-card-excerpt">{article.excerpt}</p>
            <span class="article-read-more">Lire l'article →</span>
          </div>
        </a>
      ))}
    </div>
  </main>

  <!-- FOOTER -->
  <footer>
    <p>
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/politique-de-confidentialite">Confidentialité</a>
      <a href="mailto:contact@ptidej.fr">Contact</a>
    </p>
    <p style="margin-top: 0.75rem;">© 2026 P'tit Déj — Créer par ABDWS France</p>
  </footer>
</body>
</html>
