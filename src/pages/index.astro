---
const title = "P'tit Déj — Organisez vos petits-déjeuners d'équipe";
const description = "Ptidej génère des plannings de petits-déjeuners équitables en 2 minutes. Gratuit, sans prise de tête.";
const canonical = "https://ptidej.fr";
const ogImage = "https://ptidej.fr/og.png";
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="P'tit Déj" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="P'tit Déj" />
  <meta name="theme-color" content="#D97706" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "P'tit Déj",
    "applicationCategory": "ProductivityApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
    "description": "Application web gratuite de planning de petits-déjeuners d'équipe avec rotations équitables automatiques.",
    "url": "https://ptidej.fr",
    "inLanguage": "fr"
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;0,9..40,800;1,9..40,400&display=swap" rel="stylesheet" />

  <!-- Microsoft Clarity -->
  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "x5xj8iwm95");
  </script>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --amber-50:  #FFFBEB;
      --amber-100: #FEF3C7;
      --amber-200: #FDE68A;
      --amber-400: #FBBF24;
      --amber-500: #F59E0B;
      --amber-600: #D97706;
      --amber-700: #B45309;
      --stone-50:  #FAFAF9;
      --stone-100: #F5F5F4;
      --stone-200: #E7E5E4;
      --stone-400: #A8A29E;
      --stone-600: #57534E;
      --stone-700: #44403C;
      --stone-900: #1C1917;
      --white: #FFFFFF;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background-color: var(--stone-50);
      color: var(--stone-900);
      overflow-x: hidden;
      min-height: 100vh;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
    }

    /* NAV */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 2rem;
      background: rgba(250,250,249,0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--stone-200);
    }

    .nav-logo {
      font-family: 'DM Sans', sans-serif;
      font-weight: 800;
      font-size: 1.2rem;
      color: var(--stone-900);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-logo-dot {
      width: 8px; height: 8px;
      background: var(--amber-500);
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
    }

    .nav-app-btn {
      font-family: 'DM Sans', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      background: var(--amber-500);
      color: var(--white);
      text-decoration: none;
      padding: 0.6rem 1.2rem;
      border-radius: 12px;
      transition: background 0.2s, transform 0.15s;
      white-space: nowrap;
    }
    .nav-app-btn:hover { background: var(--amber-600); transform: scale(1.02); }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .nav-link {
      font-family: 'DM Sans', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--stone-700);
      text-decoration: none;
      transition: color 0.2s;
    }
    .nav-link:hover { color: var(--amber-600); }

    /* HERO */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 7rem 2rem 4rem;
      text-align: center;
      overflow: hidden;
    }

    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 50% -10%, rgba(251,191,36,0.18) 0%, transparent 70%),
        radial-gradient(ellipse 50% 40% at 90% 80%, rgba(217,119,6,0.10) 0%, transparent 60%),
        radial-gradient(ellipse 40% 30% at 10% 70%, rgba(251,191,36,0.08) 0%, transparent 50%);
      pointer-events: none;
      z-index: 0;
    }

    .hero > * { position: relative; z-index: 1; }

    /* EYEBROW */
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--amber-700);
      background: var(--amber-50);
      border: 1px solid var(--amber-200);
      padding: 0.4rem 1rem;
      border-radius: 999px;
      margin-bottom: 2rem;
      animation: fadeUp 0.6s ease both;
    }

    /* H1 */
    h1 {
      font-family: 'DM Sans', sans-serif;
      font-weight: 800;
      font-size: clamp(1.8rem, 3.5vw, 3.2rem);
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--stone-900);
      max-width: 560px;
      margin: 0 auto 1.5rem;
      hyphens: none;
      word-break: normal;
      overflow-wrap: normal;
      animation: fadeUp 0.6s 0.1s ease both;
    }

    h1 em {
      font-style: normal;
      color: var(--amber-600);
      position: relative;
    }

    h1 em::after {
      content: '';
      position: absolute;
      bottom: 2px; left: 0; right: 0;
      height: 3px;
      background: var(--amber-400);
      border-radius: 2px;
      opacity: 0.5;
    }

    /* SUBHEAD */
    .subhead {
      font-size: clamp(0.95rem, 2vw, 1.15rem);
      color: var(--stone-600);
      max-width: 520px;
      line-height: 1.6;
      margin: 0 auto 1rem;
      animation: fadeUp 0.6s 0.2s ease both;
    }

    .subhead strong { color: var(--stone-900); font-weight: 500; }

    /* PAIN QUOTE */
    .pain-quote {
      display: inline-block;
      background: var(--white);
      border: 1px solid var(--stone-200);
      border-left: 4px solid var(--amber-500);
      border-radius: 0 12px 12px 0;
      padding: 0.75rem 1.25rem;
      font-size: 0.9rem;
      color: var(--stone-700);
      font-style: italic;
      margin-bottom: 2.5rem;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
      animation: fadeUp 0.6s 0.25s ease both;
      max-width: 480px;
    }

    /* FORM */
    .form-wrapper {
      width: 100%;
      max-width: 460px;
      animation: fadeUp 0.6s 0.3s ease both;
    }

    .form-row {
      display: flex;
      gap: 0.5rem;
      background: var(--white);
      border: 2px solid var(--stone-200);
      border-radius: 16px;
      padding: 0.4rem;
      box-shadow: 0 4px 24px rgba(0,0,0,0.08);
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-row:focus-within {
      border-color: var(--amber-400);
      box-shadow: 0 4px 24px rgba(245,158,11,0.15);
    }

    .form-row input[type="email"] {
      flex: 1;
      border: none;
      outline: none;
      background: transparent;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.95rem;
      color: var(--stone-900);
      padding: 0.6rem 0.75rem;
      min-width: 0;
    }

    .form-row input::placeholder { color: var(--stone-400); }

    .btn-primary {
      background: var(--amber-500);
      color: var(--white);
      border: none;
      border-radius: 12px;
      padding: 0.75rem 1.25rem;
      font-family: 'DM Sans', sans-serif;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s, transform 0.15s;
      flex-shrink: 0;
    }

    .btn-primary:hover { background: var(--amber-600); transform: scale(1.02); }
    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    .form-note {
      font-size: 0.75rem;
      color: var(--stone-400);
      margin-top: 0.75rem;
      text-align: center;
    }

    .form-message {
      margin-top: 0.75rem;
      font-size: 0.875rem;
      font-weight: 500;
      text-align: center;
      min-height: 1.5rem;
    }

    .form-message.success { color: #16a34a; }
    .form-message.error { color: #dc2626; }

    .app-link-hint {
      font-size: 0.82rem;
      color: var(--stone-400);
      margin-top: 0.75rem;
      text-align: center;
    }
    .app-link { color: var(--amber-600); text-decoration: none; font-weight: 500; }
    .app-link:hover { text-decoration: underline; }

    /* FEATURES */
    .features {
      padding: 5rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-label {
      font-family: 'DM Sans', sans-serif;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--amber-600);
      margin-bottom: 1rem;
      text-align: center;
    }

    .section-title {
      font-family: 'DM Sans', sans-serif;
      font-weight: 800;
      font-size: clamp(1.2rem, 2vw, 2rem);
      letter-spacing: -0.02em;
      text-align: center;
      color: var(--stone-900);
      margin-bottom: 1rem;
      hyphens: none;
    }

    .section-sub {
      text-align: center;
      color: var(--stone-600);
      max-width: 520px;
      margin: 0 auto 3.5rem;
      font-size: 1rem;
      line-height: 1.6;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
    }

    .feature-card {
      background: var(--white);
      border: 1px solid var(--stone-200);
      border-radius: 20px;
      padding: 2rem;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .feature-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.08);
    }

    .feature-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }

    .feature-title {
      font-family: 'DM Sans', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      color: var(--stone-900);
      margin-bottom: 0.5rem;
    }

    .feature-desc { font-size: 0.9rem; color: var(--stone-600); line-height: 1.6; }

    /* HOW IT WORKS */
    .how {
      background: var(--stone-900);
      color: var(--white);
      padding: 5rem 2rem;
    }

    .how-inner {
      max-width: 900px;
      margin: 0 auto;
    }

    .how .section-label { color: var(--amber-400); }
    .how .section-title { color: var(--white); }
    .how .section-sub { color: var(--stone-400); }

    .steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }

    .step { display: flex; flex-direction: column; gap: 0.75rem; }

    .step-num {
      font-family: 'DM Sans', sans-serif;
      font-weight: 800;
      font-size: 3rem;
      color: var(--amber-500);
      line-height: 1;
      opacity: 0.7;
    }

    .step-title {
      font-family: 'DM Sans', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      color: var(--white);
    }

    .step-desc { font-size: 0.875rem; color: var(--stone-400); line-height: 1.6; }

    /* CTA */
    .cta-section {
      padding: 6rem 2rem;
      text-align: center;
      background: var(--amber-50);
      border-top: 1px solid var(--amber-100);
    }

    .cta-section h2 {
      font-family: 'DM Sans', sans-serif;
      font-weight: 800;
      font-size: clamp(1.2rem, 2vw, 2rem);
      letter-spacing: -0.02em;
      color: var(--stone-900);
      margin-bottom: 1rem;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
      hyphens: none;
    }

    .cta-section p {
      color: var(--stone-600);
      margin-bottom: 2.5rem;
      font-size: 1rem;
    }

    /* FOOTER */
    footer {
      background: var(--stone-900);
      color: var(--stone-400);
      padding: 2rem 1.5rem;
      text-align: center;
      font-size: 0.8rem;
    }

    footer a {
      color: var(--stone-400);
      text-decoration: none;
      margin: 0 0.75rem;
      transition: color 0.2s;
    }

    footer a:hover { color: var(--amber-400); }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 600px) {
      nav { padding: 1rem 1.25rem; }
      .nav-app-btn { font-size: 0.78rem; padding: 0.5rem 0.9rem; }
      .form-row { flex-direction: column; padding: 0.5rem; }
      .btn-primary { width: 100%; text-align: center; }
      .features { padding: 3rem 1.25rem; }
      .how { padding: 3rem 1.25rem; }
      .cta-section { padding: 3rem 1.25rem; }
    }

    /* ── SCREENSHOTS CAROUSEL ─────────────────────────────────────── */
    .carousel-section {
      padding: 5rem 2rem;
      text-align: center;
    }

    .carousel-heading {
      font-family: 'DM Sans', sans-serif;
      font-weight: 800;
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      letter-spacing: -0.02em;
      color: var(--stone-900);
      margin-bottom: 2.5rem;
      margin-top: 0.5rem;
    }

    .browser-mockup {
      max-width: 600px;
      margin: 0 auto;
      border-radius: 12px;
      box-shadow:
        0 24px 64px rgba(0,0,0,0.10),
        0 4px 16px rgba(0,0,0,0.06),
        0 0 0 1px var(--stone-200);
      overflow: hidden;
    }

    .browser-bar {
      background: var(--stone-100);
      border-bottom: 1px solid var(--stone-200);
      padding: 0.55rem 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .browser-dot {
      width: 11px; height: 11px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .browser-dot:nth-child(1) { background: #FF5F57; }
    .browser-dot:nth-child(2) { background: #FFBD2E; }
    .browser-dot:nth-child(3) { background: #28C840; }

    .browser-url-bar {
      flex: 1;
      background: var(--stone-200);
      border-radius: 5px;
      padding: 0.25rem 0.7rem;
      margin-left: 0.4rem;
    }

    .browser-url-text {
      font-size: 0.7rem;
      color: var(--stone-600);
      font-family: 'JetBrains Mono', monospace;
    }

    .carousel-viewport {
      position: relative;
      overflow: hidden;
      height: 520px;
      background: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .carousel-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.6s ease;
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .carousel-slide.is-active {
      opacity: 1;
      pointer-events: auto;
    }

    .carousel-slide img {
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
    }

    .carousel-caption {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      background: linear-gradient(to top, rgba(28,25,23,0.65) 0%, transparent 100%);
      color: #fff;
      padding: 2.5rem 1.25rem 1rem;
      font-size: 0.88rem;
      font-weight: 600;
      text-align: left;
      letter-spacing: -0.01em;
    }

    .carousel-dots {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1.25rem;
    }

    .carousel-dot-btn {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--stone-200);
      border: none;
      cursor: pointer;
      padding: 0;
      transition: background 0.25s, transform 0.25s;
    }

    .carousel-dot-btn.is-active {
      background: var(--amber-500);
      transform: scale(1.4);
    }

    @media (max-width: 600px) {
      .carousel-section { padding: 3rem 1.25rem; }
      .carousel-viewport { height: 360px; }
    }
  </style>
</head>

<body>
  <nav>
    <a href="/" class="nav-logo">
      <span class="nav-logo-dot"></span>
      P'tit Déj
    </a>
    <div class="nav-right">
      <a href="/blog" class="nav-link">Blog</a>
      <a href="https://app.ptidej.fr" class="nav-app-btn">Accéder à l'app</a>
    </div>
  </nav>

  <section class="hero">
    <span class="eyebrow">✨ Gratuit et disponible maintenant</span>

    <h1>
      Le planning de petits-déjeuners<br />que toute l'équipe <em>respecte.</em>
    </h1>

    <p class="subhead">
      Toujours les mêmes qui apportent le café ?<br />
      <strong>Ptidej organise des rotations équitables en 2 minutes.</strong><br />
      Gratuit, sans prise de tête.
    </p>

    <p class="pain-quote">
      « C'est la 3ème fois que j'amène le p'tit déj et certains n'ont rien amené depuis des mois... »
    </p>

    <div class="form-wrapper">
      <a href="https://app.ptidej.fr" class="btn-primary">Accéder gratuitement →</a>
      <p class="form-note">🔒 Gratuit, sans carte bleue. Toujours.</p>
    </div>
  </section>

  <!-- SCREENSHOTS CAROUSEL -->
  <section class="carousel-section">
    <p class="section-label">En images</p>
    <h2 class="carousel-heading">Voir Ptidej en action</h2>

    <div class="browser-mockup" id="browser-mockup">
      <div class="browser-bar">
        <span class="browser-dot"></span>
        <span class="browser-dot"></span>
        <span class="browser-dot"></span>
        <div class="browser-url-bar">
          <span class="browser-url-text">app.ptidej.fr</span>
        </div>
      </div>

      <div class="carousel-viewport" id="carousel-viewport">
        <div class="carousel-slide is-active" data-slide="0">
          <img src="/screenshots/screenshot-1.png" alt="Le planning de la semaine, clair et lisible" width="600" height="375" loading="lazy" decoding="async" />
          <div class="carousel-caption">Le planning de la semaine, clair et lisible</div>
        </div>
        <div class="carousel-slide" data-slide="1">
          <img src="/screenshots/screenshot-2.png" alt="Une répartition 100% équitable, visible par tous" width="600" height="375" loading="lazy" decoding="async" />
          <div class="carousel-caption">Une répartition 100% équitable, visible par tous</div>
        </div>
        <div class="carousel-slide" data-slide="2">
          <img src="/screenshots/screenshot-3.png" alt="Ajustez manuellement en un clic si besoin" width="600" height="375" loading="lazy" decoding="async" />
          <div class="carousel-caption">Ajustez manuellement en un clic si besoin</div>
        </div>
      </div>
    </div>

    <div class="carousel-dots" role="group" aria-label="Navigation du carrousel">
      <button class="carousel-dot-btn is-active" data-dot="0" aria-label="Voir la capture 1"></button>
      <button class="carousel-dot-btn" data-dot="1" aria-label="Voir la capture 2"></button>
      <button class="carousel-dot-btn" data-dot="2" aria-label="Voir la capture 3"></button>
    </div>
  </section>

  <section class="features">
    <p class="section-label">Pourquoi Ptidej</p>
    <h2 class="section-title">Un planning juste, une équipe sereine</h2>
    <p class="section-sub">Conçu pour les équipes qui souhaitent maintenir le rituel du petit-déjeuner sans friction.</p>

    <div class="features-grid">
      <div class="feature-card">
